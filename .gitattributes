# Keep text diffs readable and use Windows line endings for embedded sources.
* text=auto
*.c text eol=crlf
*.h text eol=crlf
*.s text eol=crlf
*.sct text eol=crlf
*.uvprojx text eol=crlf
*.uvoptx text eol=crlf
*.ioc text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.png binary
*.jpg binary
*.pdf binary
